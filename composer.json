{
  "name": "arillo/silverstripe-arbitrarysettings",
  "description": "Arbitrary settings for DataObjects",
  "type": "silverstripe-vendormodule",
  "homepage": "https://github.com/arillo/silverstripe-arbitrarysettings",
  "keywords": [
    "silverstripe",
    "elements"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sebastian Fischer",
      "email": "sf@arillo.net"
    }
  ],
  "extra": {
    "installer-name": "arbitrarysettings",
    "expose": [
      "client"
    ],
    "branch-alias": {
      "dev-master": "3.0.x-dev"
    }
  },
  "require": {
    "silverstripe/vendor-plugin": "^3.0",
    "silverstripe/framework": "^6.0",
    "symbiote/silverstripe-multivaluefield": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Arillo\\ArbitrarySettings\\": "src/"
    }
  },
  "support": {
    "issues": "https://github.com/arillo/silverstripe-arbitrarysettings/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
